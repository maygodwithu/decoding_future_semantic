# checkpoints; see README for the pipeline.
*.pt
*.npy
*.npz

# Orchestrator run logs / per-cycle agent working directories (verbose,
# auto-generated, not needed to understand or rerun the pipeline)
logs/
**/runs/
**/_intermediate/

# OS
.DS_Store
Thumbs.db
