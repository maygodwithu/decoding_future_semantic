# Python
__pycache__/
*.pyc
*.egg-info/

# Environments (contains API keys - never commit)
.venv/
.env

# Large / regenerable experiment artifacts (raw hidden states, embeddings,
# probe weights) - multi-hundred-MB total, individual files exceed GitHub's
